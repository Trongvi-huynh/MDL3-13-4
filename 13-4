import java.sql.CallableStatement;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.util.Scanner;

public class Main {

    static String URL = "jdbc:mysql://localhost:3306/student_db";
    static String USER = "root";
    static String PASSWORD = "YOUR_PASSWORD";

    static Scanner scanner = new Scanner(System.in);

    public static void main(String[] args) {

        while (true) {

            System.out.println();
            System.out.println("===== STUDENT MANAGEMENT =====");
            System.out.println("1. Hiển thị danh sách sinh viên");
            System.out.println("2. Thêm mới sinh viên");
            System.out.println("3. Sửa sinh viên");
            System.out.println("4. Xóa sinh viên");
            System.out.println("5. Tìm kiếm sinh viên");
            System.out.println("0. Thoát");

            int choice;

            try {
                System.out.print("Nhập lựa chọn: ");
                choice = Integer.parseInt(scanner.nextLine());

                if (choice < 0 || choice > 5) {
                    System.out.println("Vui lòng nhập từ 0 đến 5!");
                    continue;
                }

            } catch (NumberFormatException e) {
                System.out.println("Lỗi: Vui lòng nhập số!");
                continue;
            }

            switch (choice) {

                case 1:
                    getAllStudents();
                    break;

                case 2:
                    addStudent();
                    break;

                case 3:
                    updateStudent();
                    break;

                case 4:
                    deleteStudent();
                    break;

                case 5:
                    searchStudent();
                    break;

                case 0:
                    System.out.println("Đã thoát chương trình.");
                    scanner.close();
                    return;
            }
        }
    }

    // 1. Hiển thị danh sách sinh viên
    public static void getAllStudents() {

        try {

            Connection connection = DriverManager.getConnection(
                    URL, USER, PASSWORD
            );

            CallableStatement statement =
                    connection.prepareCall("{CALL get_all_students()}");

            ResultSet resultSet = statement.executeQuery();

            System.out.println();
            System.out.println("===== DANH SÁCH SINH VIÊN =====");

            while (resultSet.next()) {

                int id = resultSet.getInt("student_id");
                String name = resultSet.getString("full_name");
                String dateOfBirth =
                        resultSet.getString("date_of_birth");
                String email = resultSet.getString("email");

                System.out.println("----------------------------");
                System.out.println("ID: " + id);
                System.out.println("Họ tên: " + name);
                System.out.println("Ngày sinh: " + dateOfBirth);
                System.out.println("Email: " + email);
            }

            resultSet.close();
            statement.close();
            connection.close();

        } catch (SQLException e) {

            System.out.println("Không thể lấy danh sách sinh viên!");
            System.out.println("Lỗi: " + e.getMessage());
        }
    }

    // 2. Thêm sinh viên
    public static void addStudent() {

        String fullName;
        String dateOfBirth;
        String email;

        // Nhập họ tên
        while (true) {

            System.out.print("Nhập họ tên: ");
            fullName = scanner.nextLine();

            if (fullName.trim().isEmpty()) {

                System.out.println("Họ tên không được để trống!");

            } else {

                break;
            }
        }

        // Nhập ngày sinh
        while (true) {

            System.out.print("Nhập ngày sinh (yyyy-MM-dd): ");
            dateOfBirth = scanner.nextLine();

            try {

                java.sql.Date.valueOf(dateOfBirth);
                break;

            } catch (IllegalArgumentException e) {

                System.out.println("Ngày sinh không đúng định dạng!");
                System.out.println("Vui lòng nhập theo dạng yyyy-MM-dd.");
            }
        }

        // Nhập email
        while (true) {

            System.out.print("Nhập email: ");
            email = scanner.nextLine();

            if (email.trim().isEmpty()) {

                System.out.println("Email không được để trống!");

            } else if (!email.contains("@")) {

                System.out.println("Email không đúng định dạng!");

            } else {

                break;
            }
        }

        // Gọi Stored Procedure add_student
        try {

            Connection connection = DriverManager.getConnection(
                    URL, USER, PASSWORD
            );

            CallableStatement statement =
                    connection.prepareCall(
                            "{CALL add_student(?, ?, ?)}"
                    );

            statement.setString(1, fullName);
            statement.setDate(
                    2,
                    java.sql.Date.valueOf(dateOfBirth)
            );
            statement.setString(3, email);

            statement.execute();

            System.out.println("Thêm sinh viên thành công!");

            statement.close();
            connection.close();

        } catch (SQLException e) {

            System.out.println("Không thể thêm sinh viên!");
            System.out.println("Lỗi: " + e.getMessage());
        }
    }

    // 3. Sửa sinh viên
    public static void updateStudent() {

        int id;

        // Nhập ID
        while (true) {

            try {

                System.out.print("Nhập ID sinh viên cần sửa: ");
                id = Integer.parseInt(scanner.nextLine());

                if (id <= 0) {

                    System.out.println("ID phải lớn hơn 0!");

                } else {

                    break;
                }

            } catch (NumberFormatException e) {

                System.out.println("ID phải là số!");
            }
        }

        String fullName;
        String dateOfBirth;
        String email;

        // Nhập họ tên mới
        while (true) {

            System.out.print("Nhập họ tên mới: ");
            fullName = scanner.nextLine();

            if (fullName.trim().isEmpty()) {

                System.out.println("Họ tên không được để trống!");

            } else {

                break;
            }
        }

        // Nhập ngày sinh mới
        while (true) {

            System.out.print("Nhập ngày sinh mới (yyyy-MM-dd): ");
            dateOfBirth = scanner.nextLine();

            try {

                java.sql.Date.valueOf(dateOfBirth);
                break;

            } catch (IllegalArgumentException e) {

                System.out.println("Ngày sinh không đúng định dạng!");
                System.out.println("Vui lòng nhập theo dạng yyyy-MM-dd.");
            }
        }

        // Nhập email mới
        while (true) {

            System.out.print("Nhập email mới: ");
            email = scanner.nextLine();

            if (email.trim().isEmpty()) {

                System.out.println("Email không được để trống!");

            } else if (!email.contains("@")) {

                System.out.println("Email không đúng định dạng!");

            } else {

                break;
            }
        }

        // Gọi Stored Procedure update_student
        try {

            Connection connection = DriverManager.getConnection(
                    URL, USER, PASSWORD
            );

            CallableStatement statement =
                    connection.prepareCall(
                            "{CALL update_student(?, ?, ?, ?)}"
                    );

            statement.setInt(1, id);
            statement.setString(2, fullName);
            statement.setDate(
                    3,
                    java.sql.Date.valueOf(dateOfBirth)
            );
            statement.setString(4, email);

            statement.execute();

            System.out.println("Cập nhật sinh viên thành công!");

            statement.close();
            connection.close();

        } catch (SQLException e) {

            System.out.println("Không thể cập nhật sinh viên!");
            System.out.println("Lỗi: " + e.getMessage());
        }
    }

    // 4. Xóa sinh viên
    public static void deleteStudent() {

        int id;

        // Nhập ID
        while (true) {

            try {

                System.out.print("Nhập ID sinh viên cần xóa: ");
                id = Integer.parseInt(scanner.nextLine());

                if (id <= 0) {

                    System.out.println("ID phải lớn hơn 0!");

                } else {

                    break;
                }

            } catch (NumberFormatException e) {

                System.out.println("ID phải là số!");
            }
        }

        // Gọi Stored Procedure delete_student
        try {

            Connection connection = DriverManager.getConnection(
                    URL, USER, PASSWORD
            );

            CallableStatement statement =
                    connection.prepareCall(
                            "{CALL delete_student(?)}"
                    );

            statement.setInt(1, id);

            statement.execute();

            System.out.println("Xóa sinh viên thành công!");

            statement.close();
            connection.close();

        } catch (SQLException e) {

            System.out.println("Không thể xóa sinh viên!");
            System.out.println("Lỗi: " + e.getMessage());
        }
    }

    // 5. Tìm kiếm sinh viên
    public static void searchStudent() {

        String name;

        // Nhập tên cần tìm
        while (true) {

            try {

                System.out.print("Nhập tên sinh viên cần tìm: ");
                name = scanner.nextLine();

                if (name.trim().isEmpty()) {

                    System.out.println("Tên không được để trống!");

                } else {

                    break;
                }

            } catch (Exception e) {

                System.out.println("Dữ liệu không hợp lệ!");
            }
        }

        // Gọi Stored Procedure search_student
        try {

            Connection connection = DriverManager.getConnection(
                    URL, USER, PASSWORD
            );

            CallableStatement statement =
                    connection.prepareCall(
                            "{CALL search_student(?)}"
                    );

            statement.setString(1, name);

            ResultSet resultSet = statement.executeQuery();

            System.out.println();
            System.out.println("===== KẾT QUẢ TÌM KIẾM =====");

            boolean found = false;

            while (resultSet.next()) {

                found = true;

                int id = resultSet.getInt("student_id");
                String fullName =
                        resultSet.getString("full_name");
                String dateOfBirth =
                        resultSet.getString("date_of_birth");
                String email =
                        resultSet.getString("email");

                System.out.println("----------------------------");
                System.out.println("ID: " + id);
                System.out.println("Họ tên: " + fullName);
                System.out.println("Ngày sinh: " + dateOfBirth);
                System.out.println("Email: " + email);
            }

            if (!found) {

                System.out.println("Không tìm thấy sinh viên!");
            }

            resultSet.close();
            statement.close();
            connection.close();

        } catch (SQLException e) {

            System.out.println("Không thể tìm kiếm sinh viên!");
            System.out.println("Lỗi: " + e.getMessage());
        }
    }
}
